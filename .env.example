# Copy this file to .env. Existing environment variables take precedence.
ASSISTANT_DATA_DIR=data
LLM_PROVIDER=stub
# Required for providers other than stub. Never commit a real key.
LLM_API_KEY=
CREDIT_RATE_VND=450000
RETAKE_MULTIPLIER=1.5
MAX_CREDITS=30
LOG_LEVEL=INFO

# Lab04 — API
# Set a local admin key in .env to enable admin feedback access.
API_ADMIN_KEY=
WEATHER_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_S=3
CAMPUS_LAT=10.7626
CAMPUS_LON=106.6822
RATE_LIMIT_PER_MIN=30


# Lab05 - Database
DATABASE_URL=sqlite:///assistant.db
# For local development. Set a random secret in your own .env when needed.
SESSION_SALT=dev-salt
